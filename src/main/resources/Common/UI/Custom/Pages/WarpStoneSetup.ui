$C = "../Common.ui";

$C.@PageOverlay {

  $C.@Container {
    Anchor: (Width: 520, Height: 240);

    #Title {
      Group {
        $C.@Title {
          @Text = "WarpStone";
        }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Left: 30, Right: 30, Top: 70, Bottom: 20);

      Group #RowName {
        Anchor: (Height: 34);

        Label #NameLabel {
          Text: "Nom :";
          Style: $C.@DefaultLabelStyle;
          Anchor: (Top: 7, Left: 0);
        }

        $C.@TextField #NameInput {
          @Anchor = Anchor(Top: 0, Left: 80, Right: 0, Height: 34);
          PlaceholderText: "Ma WarpStone";
        }
      }

      Group #Spacer {
        Anchor: (Height: 12);
      }

      $C.@TextButton #SaveButton {
        @Text = "Sauvegarder";
        @Anchor = Anchor(Width: 180, Height: 34);
      }
    }
  }
}

$C.@BackButton {}
